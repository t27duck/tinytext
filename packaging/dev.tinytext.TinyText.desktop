[Desktop Entry]
Type=Application
Name=tinytext
GenericName=Text Editor
Comment=A tiny plaintext editor
Exec=tinytext %F
Icon=accessories-text-editor
Terminal=false
Categories=Utility;TextEditor;
MimeType=text/plain;text/markdown;text/x-markdown;
Keywords=text;editor;plaintext;notes;
StartupNotify=true
StartupWMClass=dev.tinytext.TinyText
